// Redirects the pre-rename domain netrust.yemelianov.dev to nethacked.yemelianov.dev.
// Deploy: (cd deploy/cloudflare/legacy-redirect && npx wrangler deploy)
{
  "name": "netrust",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "netrust.yemelianov.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
